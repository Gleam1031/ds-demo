new file mode 100644
index 0000000..02819d7
--- /dev/null
+++ b/src/services/chat/pins.ts
@@ -0,0 +1,49 @@
+import { create } from 'zustand'
+
+/**
+ * 会话置顶：只存 id 列表，与会话数据分开保存在本机 localStorage。
+ * 置顶不改变会话本身的 updatedAt，删除会话时残留的 id 会在渲染时被过滤掉。
+ */
+const STORAGE_KEY = 'chat-demo:pinned-sessions'
+
+const readPinned = (): string[] => {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY)
+    const parsed: unknown = raw ? JSON.parse(raw) : null
+    return Array.isArray(parsed) ? parsed.filter((id): id is string => typeof id === 'string') : []
+  } catch {
+    return []
+  }
+}
+
+const writePinned = (ids: string[]) => {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(ids))
+  } catch {
+    // 隐私模式等场景下忽略；置顶只在当前会话生效
+  }
+}
+
+type PinsState = { ids: string[] }
+
+export const usePins = create<PinsState>(() => ({ ids: readPinned() }))
+
+export const isPinned = (id: string) => usePins.getState().ids.includes(id)
+
+/** 置顶 / 取消置顶；新置顶的排在最前 */
+export const togglePin = (id: string) => {
+  const ids = usePins.getState().ids
+  const next = ids.includes(id) ? ids.filter((item) => item !== id) : [id, ...ids]
+  writePinned(next)
+  usePins.setState({ ids: next })
+}
+
+/** 按置顶顺序排好的置顶会话；others 保持原有顺序 */
+export const splitPinned = <T extends { id: string }>(sessions: T[], ids = usePins.getState().ids) => {
+  const byId = new Map(sessions.map((session) => [session.id, session]))
+  const pinned = ids
+    .map((id) => byId.get(id))
+    .filter((session): session is T => session !== undefined)
+  const pinnedSet = new Set(pinned.map((session) => session.id))
+  return { pinned, others: sessions.filter((session) => !pinnedSet.has(session.id)) }
+}
