+.personalizationArrow {
+  display: flex;
+  flex-shrink: 0;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+/* ---------- 个性化子页面 ---------- */
+
+/* 面板本身要当滚动容器：弹窗是固定高度的 flex，否则内容会被裁掉 */
+.personalization {
+  display: flex;
+  flex: 1 1 0;
+  flex-direction: column;
+  gap: 20px;
+  min-width: 0;
+  min-height: 0;
+  margin-right: -24px;
+  padding: 0 24px 8px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  -webkit-overflow-scrolling: touch;
+}
+
+.personalizationBack {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  align-self: flex-start;
+  padding: 4px 8px 4px 4px;
+  margin-left: -4px;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 13.5px;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.personalizationBack:active {
+  background: var(--dsw-alias-interactive-bg-hover);
+}
+
+.personalizationBackIcon {
+  display: flex;
+  transform: rotate(180deg);
+}
+
+.personalizationSection {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.personalizationTitle {
+  font-size: 14px;
+  line-height: 22px;
+  color: var(--dsw-alias-label-primary);
+  font-weight: 500;
+}
+
+.personalizationTitleRow {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 8px;
+}
+
+.personalizationValue {
+  font-size: 13px;
+  color: var(--dsw-alias-brand-primary);
+}
+
+/* 系统提示词输入：宽度固定整行，高度由 JS 随内容增长（一行起） */
+.personalizationTextarea {
+  box-sizing: border-box;
+  display: block;
+  width: 100%;
+  min-height: 40px;
+  padding: 9px 12px;
+  /* 边框由主题文字色派生：浅色=黑、深色=白，自动跟随主题 */
+  border: 1px solid var(--dsw-alias-label-tertiary);
+  border-color: color-mix(in srgb, var(--dsw-alias-label-primary) 42%, transparent);
+  border-radius: 10px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+  font-size: 14px;
+  line-height: 1.6;
+  font-family: inherit;
+  resize: none;
+  overflow: hidden;
+  outline: none;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.personalizationTextarea:focus {
+  border-color: var(--dsw-alias-brand-primary);
+}
+
+.personalizationTextarea::placeholder {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.personalizationHint {
+  font-size: 12.5px;
+  line-height: 1.5;
+  color: var(--dsw-alias-label-tertiary);
