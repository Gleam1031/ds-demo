diff --git a/src/services/wallpapers.ts b/src/services/wallpapers.ts
new file mode 100644
index 0000000..c57327d
--- /dev/null
+++ b/src/services/wallpapers.ts
@@ -0,0 +1,209 @@
+import { openDB, type IDBPDatabase } from 'idb'
+import { useEffect, useState } from 'react'
+import { create } from 'zustand'
+
+/** 三种壁纸：启动页、主页（新建对话欢迎页）、聊天页 */
+export type WallpaperKind = 'launch' | 'home' | 'chat'
+
+export type WallpaperMeta = {
+  mime: string
+  name: string
+}
+
+/** 每张背景：独立开关 + 背景强度（0..100，0 接近原生、100 最清楚） */
+type WallpaperItem = { on: boolean; opacity: number; meta: WallpaperMeta | null }
+type WallpaperSettings = { master: boolean; items: Record<WallpaperKind, WallpaperItem> }
+
+const STORAGE_KEY = 'chat-demo:wallpapers'
+const DB_NAME = 'chat-demo-wallpapers'
+const STORE = 'wallpapers'
+const KINDS: WallpaperKind[] = ['launch', 'home', 'chat']
+
+/** 主页壁纸只吃静态图；启动/聊天壁纸可以是图片或视频 */
+export const WALLPAPER_ACCEPT: Record<WallpaperKind, string> = {
+  launch: 'image/*,video/*',
+  home: 'image/png,image/jpeg',
+  chat: 'image/*,video/*',
+}
+
+export const isVideoMeta = (meta: WallpaperMeta | null | undefined): boolean =>
+  !!meta?.mime.startsWith('video/')
+
+export const DEFAULT_OPACITY = 100
+export const clampOpacity = (value: number): number =>
+  Number.isFinite(value) ? Math.min(100, Math.max(0, Math.round(value))) : DEFAULT_OPACITY
+
+const defaultItems = (): Record<WallpaperKind, WallpaperItem> => ({
+  launch: { on: true, opacity: DEFAULT_OPACITY, meta: null },
+  home: { on: true, opacity: DEFAULT_OPACITY, meta: null },
+  chat: { on: true, opacity: DEFAULT_OPACITY, meta: null },
+})
+
+const normalizeItems = (value: unknown): Record<WallpaperKind, WallpaperItem> => {
+  const items = defaultItems()
+  if (!value || typeof value !== 'object') {
+    return items
+  }
+  for (const kind of KINDS) {
+    const raw = (value as Record<string, unknown>)[kind]
+    if (!raw || typeof raw !== 'object') {
+      continue
+    }
+    const record = raw as { on?: unknown; opacity?: unknown; meta?: unknown }
+    const meta = record.meta as { mime?: unknown; name?: unknown } | null | undefined
+    items[kind] = {
+      on: record.on !== false,
+      opacity: clampOpacity(typeof record.opacity === 'number' ? record.opacity : DEFAULT_OPACITY),
+      meta: meta && typeof meta.mime === 'string' ? { mime: meta.mime, name: String(meta.name ?? '') } : null,
+    }
+  }
+  return items
+}
+
+const readSettings = (): WallpaperSettings => {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null')
+    if (!parsed || typeof parsed !== 'object') {
+      return { master: false, items: defaultItems() }
+    }
+    return {
+      master: (parsed as { master?: unknown }).master === true,
+      items: normalizeItems((parsed as { items?: unknown }).items),
+    }
+  } catch {
+    return { master: false, items: defaultItems() }
+  }
+}
+
+export const useWallpapers = create<WallpaperSettings>(() => readSettings())
+
+const persist = () => {
+  const { master, items } = useWallpapers.getState()
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify({ master, items }))
+  } catch {
+    // 存不下就只在本会话内生效
+  }
+}
+
+/** 总开关：一键开启/关闭全部壁纸 */
+export const setWallpaperMaster = (master: boolean) => {
+  useWallpapers.setState({ master })
+  persist()
+}
+
+/** 单个壁纸的独立开关 */
+export const setWallpaperOn = (kind: WallpaperKind, on: boolean) => {
+  const { items } = useWallpapers.getState()
+  useWallpapers.setState({ items: { ...items, [kind]: { ...items[kind], on } } })
+  persist()
+}
+
+const setItemMeta = (kind: WallpaperKind, meta: WallpaperMeta | null) => {
+  const { items } = useWallpapers.getState()
+  useWallpapers.setState({
+    items: { ...items, [kind]: { ...items[kind], on: true, meta } },
+  })
+  persist()
+}
+
+/** 背景强度：0 接近原生，100 壁纸最清楚 */
+export const setWallpaperOpacity = (kind: WallpaperKind, opacity: number) => {
+  const { items } = useWallpapers.getState()
+  useWallpapers.setState({
+    items: { ...items, [kind]: { ...items[kind], opacity: clampOpacity(opacity) } },
+  })
+  persist()
+}
+
+// ---------- 文件本体存在独立的 IndexedDB 里（视频可能有几十 MB，不能塞 localStorage） ----------
+
+let dbPromise: Promise<IDBPDatabase<unknown>> | null = null
+
+const getDB = () => {
+  dbPromise ??= openDB(DB_NAME, 1, {
+    upgrade(db) {
+      if (!db.objectStoreNames.contains(STORE)) {
+        db.createObjectStore(STORE)
+      }
+    },
+  })
+  return dbPromise
+}
+
+const loadBlob = async (kind: WallpaperKind): Promise<Blob | null> => {
+  try {
+    const db = await getDB()
+    const value = (await db.get(STORE, kind)) as { blob?: Blob } | undefined
+    return value?.blob ?? null
+  } catch {
+    return null
+  }
+}
+
+/** 保存壁纸：写文件 + 记录元数据（主页壁纸顺带检测透明像素） */
+export const saveWallpaper = async (kind: WallpaperKind, file: File): Promise<void> => {
+  const meta: WallpaperMeta = { mime: file.type, name: file.name }
+  const db = await getDB()
+  await db.put(STORE, { blob: file }, kind)
+  setItemMeta(kind, meta)
+}
+
+/** 清除壁纸：删文件 + 清元数据 */
+export const clearWallpaper = async (kind: WallpaperKind): Promise<void> => {
+  try {
+    const db = await getDB()
+    await db.delete(STORE, kind)
+  } finally {
+    setItemMeta(kind, null)
+  }
+}
+
+/**
+ * 读出三种壁纸的 objectURL（没设置的为 undefined）。
+ * 元数据变化时重新创建，旧 URL 会被回收，避免内存泄漏。
+ */
+export const useWallpaperUrls = (): Partial<Record<WallpaperKind, string>> => {
+  const signature = useWallpapers((state) =>
+    KINDS.map(
+      (kind) => `${kind}:${state.items[kind].meta?.mime ?? ''}:${state.items[kind].meta?.name ?? ''}`
+    ).join('|')
+  )
+  const [urls, setUrls] = useState<Partial<Record<WallpaperKind, string>>>({})
+
+  useEffect(() => {
+    let cancelled = false
+    const created: Partial<Record<WallpaperKind, string>> = {}
+
+    const run = async () => {
+      for (const kind of KINDS) {
+        const blob = await loadBlob(kind)
+        if (blob && !cancelled) {
+          created[kind] = URL.createObjectURL(blob)
+        }
+      }
+      if (cancelled) {
+        for (const url of Object.values(created)) {
+          if (url) {
+            URL.revokeObjectURL(url)
+          }
+        }
+        return
+      }
+      setUrls(created)
+    }
+
+    void run()
+
+    return () => {
+      cancelled = true
+      for (const url of Object.values(created)) {
+        if (url) {
+          URL.revokeObjectURL(url)
+        }
+      }
+    }
+  }, [signature])
+
+  return urls
+}
