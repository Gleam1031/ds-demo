diff --git a/src/components/settings/PersonalizationPanel.tsx b/src/components/settings/PersonalizationPanel.tsx
new file mode 100644
index 0000000..e4bff5b
--- /dev/null
+++ b/src/components/settings/PersonalizationPanel.tsx
@@ -0,0 +1,268 @@
+import clsx from 'clsx'
+import { useLayoutEffect, useRef, useState } from 'react'
+import { useTranslate } from '../../i18n/index.js'
+import {
+  DEFAULT_THINKING_LEVEL,
+  resetPersonalization,
+  setSystemPrompt,
+  setThinkingLevel,
+  THINKING_BUDGETS,
+  useSettings,
+} from '../../services/settings.js'
+import {
+  clearWallpaper,
+  saveWallpaper,
+  setWallpaperMaster,
+  setWallpaperOn,
+  setWallpaperOpacity,
+  WALLPAPER_ACCEPT,
+  type WallpaperKind,
+  useWallpapers,
+} from '../../services/wallpapers.js'
+import { Button } from '../base/Button.js'
+import { IconChevronRightOutline14 } from '../base/icons.js'
+import { Switch } from '../base/Switch.js'
+import { showToast } from '../base/toastState.js'
+import styles from './Settings.module.css'
+
+/** 文本框最小高度：一行字 */
+const TEXTAREA_MIN_HEIGHT = 40
+
+/** 三种壁纸：顺序即展示顺序 */
+const WALLPAPER_KINDS: WallpaperKind[] = ['launch', 'home', 'chat']
+
+const WALLPAPER_LABEL_KEYS = {
+  launch: 'personalizationWallpaperLaunch',
+  home: 'personalizationWallpaperHome',
+  chat: 'personalizationWallpaperChat',
+} as const
+
+/**
+ * 个性化页：设置弹窗内的子页面。
+ * 第一板块：自定义系统提示词（草稿 + 保存）；
+ * 第二板块：思考强度挡位（草稿 + 保存）；
+ * 第三板块：壁纸（立即生效，不受保存按钮影响）；
+ * 底部：恢复默认设置 / 保存修改设置。
+ */
+export const PersonalizationPanel = ({ onBack }: { onBack: () => void }) => {
+  const t = useTranslate()
+  const systemPrompt = useSettings((state) => state.systemPrompt)
+  const thinkingLevel = useSettings((state) => state.thinkingLevel)
+  const placeholder = t('personalizationSystemPromptPlaceholder')
+
+  // 草稿：面板内的编辑都先落在这里
+  const [draftPrompt, setDraftPrompt] = useState(systemPrompt)
+  const [draftLevel, setDraftLevel] = useState(thinkingLevel)
+  const dirty = draftPrompt !== systemPrompt || draftLevel !== thinkingLevel
+
+  const budget = THINKING_BUDGETS[draftLevel] ?? THINKING_BUDGETS[DEFAULT_THINKING_LEVEL]
+  const levelLabels = [
+    t('personalizationLevel1'),
+    t('personalizationLevel2'),
+    t('personalizationLevel3'),
+    t('personalizationLevel4'),
+    t('personalizationLevel5'),
+  ]
+
+  const textareaRef = useRef<HTMLTextAreaElement>(null)
+  const fileRefs = useRef<Partial<Record<WallpaperKind, HTMLInputElement | null>>>({})
+
+  const wallpaperMaster = useWallpapers((state) => state.master)
+  const wallpaperItems = useWallpapers((state) => state.items)
+
+  // 高度随内容增长：先复位成 auto 再量 scrollHeight，最小保持一行
+  useLayoutEffect(() => {
+    const textarea = textareaRef.current
+    if (!textarea) {
+      return
+    }
+    textarea.style.height = 'auto'
+    textarea.style.height = `${Math.max(TEXTAREA_MIN_HEIGHT, textarea.scrollHeight)}px`
+  }, [draftPrompt])
+
+  const save = () => {
+    setSystemPrompt(draftPrompt)
+    setThinkingLevel(draftLevel)
+    showToast({ key: 'personalizationSaved' })
+  }
+
+  const restoreDefaults = () => {
+    resetPersonalization()
+    setDraftPrompt('')
+    setDraftLevel(DEFAULT_THINKING_LEVEL)
+    showToast({ key: 'personalizationResetDone' })
+  }
+
+  const pickWallpaper = (kind: WallpaperKind, file: File) => {
+    if (kind === 'home' && file.type.startsWith('video/')) {
+      showToast({ key: 'personalizationWallpaperVideoUnsupported', type: 'error' })
+      return
+    }
+    void (async () => {
+      await saveWallpaper(kind, file)
+      showToast({ key: 'personalizationWallpaperSaved' })
+    })()
+  }
+
+  const clear = (kind: WallpaperKind) => {
+    void (async () => {
+      await clearWallpaper(kind)
+      showToast({ key: 'personalizationWallpaperCleared' })
+    })()
+  }
+
+  return (
+    <div className={styles.personalization}>
+      <button type="button" className={styles.personalizationBack} onClick={onBack}>
+        <span className={styles.personalizationBackIcon} aria-hidden="true">
+          <IconChevronRightOutline14 />
+        </span>
+        {t('personalizationBack')}
+      </button>
+
+      <section className={styles.personalizationSection}>
+        <div className={styles.personalizationTitle}>{t('personalizationSystemPrompt')}</div>
+        <textarea
+          ref={textareaRef}
+          className={styles.personalizationTextarea}
+          value={draftPrompt}
+          rows={1}
+          placeholder={placeholder}
+          aria-label={t('personalizationSystemPrompt')}
+          onChange={(event) => setDraftPrompt(event.target.value)}
+        />
+        <div className={styles.personalizationHint}>{t('personalizationSystemPromptHint')}</div>
+      </section>
+
+      <section className={styles.personalizationSection}>
+        <div className={styles.personalizationTitleRow}>
+          <div className={styles.personalizationTitle}>{t('personalizationThinking')}</div>
+          <div className={styles.personalizationValue}>
+            {levelLabels[draftLevel]} · {budget}
+          </div>
+        </div>
+        <input
+          type="range"
+          className={styles.personalizationSlider}
+          min={0}
+          max={THINKING_BUDGETS.length - 1}
+          step={1}
+          value={draftLevel}
+          aria-label={t('personalizationThinking')}
+          onChange={(event) => setDraftLevel(Number(event.target.value))}
+        />
+        <div className={styles.personalizationTicks}>
+          {levelLabels.map((label, index) => (
+            <span
+              key={label}
+              className={clsx(
+                styles.personalizationTick,
+                index === draftLevel && styles.personalizationTickActive
+              )}
+            >
+              {label}
+            </span>
+          ))}
+        </div>
+        <div className={styles.personalizationHint}>{t('personalizationThinkingHint')}</div>
+      </section>
+
+      <section className={styles.personalizationSection}>
+        <div className={styles.personalizationTitleRow}>
+          <div className={styles.personalizationTitle}>{t('personalizationWallpaper')}</div>
+          <Switch
+            checked={wallpaperMaster}
+            label={t('personalizationWallpaper')}
+            onChange={setWallpaperMaster}
+          />
+        </div>
+
+        {WALLPAPER_KINDS.map((kind) => {
+          const item = wallpaperItems[kind]
+          const meta = item.meta
+          return (
+            <div key={kind} className={styles.wallpaperGroup}>
+            <div className={styles.wallpaperRow}>
+              <div className={styles.wallpaperInfo}>
+                <div className={styles.wallpaperLabel}>{t(WALLPAPER_LABEL_KEYS[kind])}</div>
+                <div className={styles.wallpaperMeta} title={meta?.name ?? ''}>
+                  {meta ? meta.name : t('personalizationWallpaperNone')}
+                </div>
+              </div>
+              <Switch
+                checked={item.on}
+                disabled={!wallpaperMaster}
+                label={t(WALLPAPER_LABEL_KEYS[kind])}
+                onChange={(on) => setWallpaperOn(kind, on)}
+              />
+              <Button
+                variant="outlined"
+                size="s"
+                onClick={() => fileRefs.current[kind]?.click()}
+              >
+                {meta ? t('personalizationWallpaperReplace') : t('personalizationWallpaperPick')}
+              </Button>
+              {meta ? (
+                <button
+                  type="button"
+                  className={styles.wallpaperClear}
+                  onClick={() => clear(kind)}
+                >
+                  {t('personalizationWallpaperClear')}
+                </button>
+              ) : null}
+              <input
+                ref={(node) => {
+                  fileRefs.current[kind] = node
+                }}
+                type="file"
+                hidden
+                accept={WALLPAPER_ACCEPT[kind]}
+                onChange={(event) => {
+                  const file = event.target.files?.[0]
+                  event.target.value = ''
+                  if (file) {
+                    pickWallpaper(kind, file)
+                  }
+                }}
+              />
+            </div>
+            <div className={styles.wallpaperOpacity}>
+              <span className={styles.wallpaperOpacityLabel}>{t('personalizationWallpaperOpacity')}</span>
+              <input
+                type="range"
+                className={styles.wallpaperOpacitySlider}
+                min={0}
+                max={100}
+                step={5}
+                value={item.opacity}
+                disabled={!wallpaperMaster || !meta}
+                aria-label={t('personalizationWallpaperOpacity')}
+                onChange={(event) => setWallpaperOpacity(kind, Number(event.target.value))}
+              />
+              <span className={styles.wallpaperOpacityValue}>{item.opacity}%</span>
+            </div>
+            </div>
+          )
+        })}
+
+        <div className={styles.personalizationHint}>{t('personalizationWallpaperHint')}</div>
+      </section>
+
+      <div className={styles.personalizationActions}>
+        <Button variant="outlined" size="m" className={styles.personalizationAction} onClick={restoreDefaults}>
+          {t('personalizationReset')}
+        </Button>
+        <Button
+          variant="primary"
+          size="m"
+          className={styles.personalizationAction}
+          disabled={!dirty}
+          onClick={save}
+        >
+          {t('personalizationSave')}
+        </Button>
+      </div>
+    </div>
+  )
+}
