+const SNIPPET_RADIUS = 36
+
+/**
+ * 本机会话动辄上千条、几十 MB，每次搜索都全量读 IndexedDB 要好几秒。
+ * 这里把"可搜索文本"缓存一小段时间：同一轮搜索里多次输入只读一次库。
+ */
+const INDEX_TTL = 60_000
+
+type IndexEntry = { id: string; updatedAt: number; title: string; text: string }
+type Index = { signature: string; builtAt: number; entries: IndexEntry[] }
+
+let index: Index | null = null
+
+/** 会话列表指纹：条数 + updatedAt 之和，变了就说明有增删或新消息 */
+const currentSignature = () => {
+  const sessions = useChatStore.getState().sessions
+  let sum = 0
+  for (const session of sessions) {
+    sum += session.updatedAt
+  }
+  return `${sessions.length}:${sum}`
+}
+
+/** 把会话里可搜索的文字拼起来：用户提问正文 + 回答的文本块（不含思考、工具结果） */
+const sessionText = (session: Session): string => {
+  const parts: string[] = []
+  for (const message of session.messages) {
+    if (message.role === 'user') {
+      if (message.content.trim()) {
+        parts.push(message.content)
+      }
+      continue
+    }
+    for (const block of message.blocks) {
+      if (block.type === 'text' && block.text.trim()) {
+        parts.push(block.text)
+      }
+    }
+  }
+  return parts.join('\n')
+}
+
+const buildEntry = (session: Session): IndexEntry => ({
+  id: session.id,
+  updatedAt: session.updatedAt,
+  title: session.title ?? '',
+  text: sessionText(session),
+})
+
+const getEntries = async (): Promise<IndexEntry[]> => {
+  const signature = currentSignature()
+  if (index && index.signature === signature && Date.now() - index.builtAt < INDEX_TTL) {
+    return index.entries
+  }
+  const sessions = await loadAllSessions()
+  const entries = sessions.map(buildEntry)
+  index = { signature, builtAt: Date.now(), entries }
+  return entries
+}
+
+/**
+ * 提前构建搜索索引（打开侧边栏时调用）：会话多时首次建索引要几秒，
+ * 放在后台先做，用户真正点开搜索时通常已经就绪。
+ */
+export const warmSessionSearchIndex = () => {
+  void getEntries().catch(() => {
+    // 预热失败不影响之后的正常搜索
+  })
+}
+
+/** 搜索用到的摘要优先取 store 里的原件（createdAt 等信息完整）；缺失时退化构造一个 */
+const summaryOf = (entry: IndexEntry, known: Map<string, SessionSummary>): SessionSummary =>
+  known.get(entry.id) ?? {
+    id: entry.id,
+    title: entry.title,
+    createdAt: entry.updatedAt,
+    updatedAt: entry.updatedAt,
+  }
+
+const makeSnippet = (text: string, index: number, length: number): string => {
+  const start = Math.max(0, index - SNIPPET_RADIUS)
+  const end = Math.min(text.length, index + length + SNIPPET_RADIUS)
+  const body = text.slice(start, end).replace(/\s+/g, ' ').trim()
+  return `${start > 0 ? '…' : ''}${body}${end < text.length ? '…' : ''}`
+}
+
+/** 用户输入按字面量匹配，避免把 . * 等当成正则元字符 */
+const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+
+/**
+ * 本地全文搜索：匹配标题与消息正文，不区分大小写。
+ * 结果按最近更新排序；`limit` 限制返回条数，避免长列表卡顿。
+ *
+ * 用带 `i` 标志的正则而不是 `toLowerCase()`：几十 MB 文本下前者快一个数量级，
+ * 也不会额外复制一份小写文本占用内存。
+ */
+export const searchSessions = async (query: string, limit = 30): Promise<SessionSearchHit[]> => {
+  const keyword = query.trim()
+  if (!keyword) {
+    return []
+  }
+
+  const pattern = new RegExp(escapeRegExp(keyword), 'i')
+  const entries = await getEntries()
+  const known = new Map(useChatStore.getState().sessions.map((session) => [session.id, session]))
+  const hits: SessionSearchHit[] = []
+
+  for (const entry of entries) {
+    const inTitle = pattern.test(entry.title)
+    const match = inTitle ? null : pattern.exec(entry.text)
+    if (!inTitle && !match) {
+      continue
+    }
+    hits.push({
+      session: summaryOf(entry, known),
+      snippet: match ? makeSnippet(entry.text, match.index, match[0].length) : undefined,
+    })
+  }
+
+  return hits.sort((a, b) => b.session.updatedAt - a.session.updatedAt).slice(0, limit)
+}
