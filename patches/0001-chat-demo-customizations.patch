diff --git a/src/components/settings/PersonalizationPanel.tsx b/src/components/settings/PersonalizationPanel.tsx
new file mode 100644
index 0000000..05fd3be
--- /dev/null
+++ b/src/components/settings/PersonalizationPanel.tsx
@@ -0,0 +1,119 @@
+import clsx from 'clsx'
+import { useLayoutEffect, useRef } from 'react'
+import { useTranslate } from '../../i18n/index.js'
+import {
+  DEFAULT_THINKING_LEVEL,
+  resetPersonalization,
+  setSystemPrompt,
+  setThinkingLevel,
+  THINKING_BUDGETS,
+  useSettings,
+} from '../../services/settings.js'
+import { IconChevronRightOutline14 } from '../base/icons.js'
+import { showToast } from '../base/toastState.js'
+import styles from './Settings.module.css'
+
+/** 文本框最小高度：一行字 */
+const TEXTAREA_MIN_HEIGHT = 40
+
+/**
+ * 个性化页：设置弹窗内的子页面。
+ * 第一板块：自定义系统提示词 —— 宽度固定整行，高度随输入内容自动增长（一行起）；
+ * 第二板块：思考强度挡位（映射 thinking.budget_tokens）；
+ * 底部：恢复默认设置。
+ */
+export const PersonalizationPanel = ({ onBack }: { onBack: () => void }) => {
+  const t = useTranslate()
+  const systemPrompt = useSettings((state) => state.systemPrompt)
+  const thinkingLevel = useSettings((state) => state.thinkingLevel)
+  const budget = THINKING_BUDGETS[thinkingLevel] ?? THINKING_BUDGETS[DEFAULT_THINKING_LEVEL]
+  const placeholder = t('personalizationSystemPromptPlaceholder')
+  const levelLabels = [
+    t('personalizationLevel1'),
+    t('personalizationLevel2'),
+    t('personalizationLevel3'),
+    t('personalizationLevel4'),
+    t('personalizationLevel5'),
+  ]
+
+  const textareaRef = useRef<HTMLTextAreaElement>(null)
+
+  // 高度随内容增长：先复位成 auto 再量 scrollHeight，最小保持一行
+  useLayoutEffect(() => {
+    const textarea = textareaRef.current
+    if (!textarea) {
+      return
+    }
+    textarea.style.height = 'auto'
+    textarea.style.height = `${Math.max(TEXTAREA_MIN_HEIGHT, textarea.scrollHeight)}px`
+  }, [systemPrompt])
+
+  return (
+    <div className={styles.personalization}>
+      <button type="button" className={styles.personalizationBack} onClick={onBack}>
+        <span className={styles.personalizationBackIcon} aria-hidden="true">
+          <IconChevronRightOutline14 />
+        </span>
+        {t('personalizationBack')}
+      </button>
+
+      <section className={styles.personalizationSection}>
+        <div className={styles.personalizationTitle}>{t('personalizationSystemPrompt')}</div>
+        <textarea
+          ref={textareaRef}
+          className={styles.personalizationTextarea}
+          value={systemPrompt}
+          rows={1}
+          placeholder={placeholder}
+          aria-label={t('personalizationSystemPrompt')}
+          onChange={(event) => setSystemPrompt(event.target.value)}
+        />
+        <div className={styles.personalizationHint}>{t('personalizationSystemPromptHint')}</div>
+      </section>
+
+      <section className={styles.personalizationSection}>
+        <div className={styles.personalizationTitleRow}>
+          <div className={styles.personalizationTitle}>{t('personalizationThinking')}</div>
+          <div className={styles.personalizationValue}>
+            {levelLabels[thinkingLevel]} · {budget}
+          </div>
+        </div>
+        <input
+          type="range"
+          className={styles.personalizationSlider}
+          min={0}
+          max={THINKING_BUDGETS.length - 1}
+          step={1}
+          value={thinkingLevel}
+          aria-label={t('personalizationThinking')}
+          onChange={(event) => setThinkingLevel(Number(event.target.value))}
+        />
+        <div className={styles.personalizationTicks}>
+          {levelLabels.map((label, index) => (
+            <span
+              key={label}
+              className={clsx(
+                styles.personalizationTick,
+                index === thinkingLevel && styles.personalizationTickActive
+              )}
+            >
+              {label}
+            </span>
+          ))}
+        </div>
+        <div className={styles.personalizationHint}>{t('personalizationThinkingHint')}</div>
+      </section>
+
+      <button
+        type="button"
+        className={styles.personalizationReset}
+        onClick={() => {
+          resetPersonalization()
+          showToast({ key: 'personalizationResetDone' })
+        }}
+      >
+        {t('personalizationReset')}
+      </button>
+    </div>
+  )
+}
