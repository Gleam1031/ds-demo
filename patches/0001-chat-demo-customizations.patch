--- /dev/null
+++ b/src/components/sider/SessionSearch.tsx
@@ -0,0 +1,96 @@
+import { useEffect, useState } from 'react'
+import { useTranslate } from '../../i18n/index.js'
+import { searchSessions, type SessionSearchHit } from '../../services/chat/search.js'
+import { selectSession } from '../../services/chat/store.js'
+import { Modal } from '../base/Modal.js'
+import { closeMobileSider } from './mobileSiderState.js'
+import { closeSessionSearch, useSessionSearch } from './sessionSearchState.js'
+import styles from './SessionSearch.module.css'
+
+/** 输入停顿后再查，避免每次按键都扫一遍本机会话库 */
+const SEARCH_DELAY = 180
+
+const SessionSearchDialog = () => {
+  const t = useTranslate()
+  const [query, setQuery] = useState('')
+  const [hits, setHits] = useState<SessionSearchHit[]>([])
+  const [searching, setSearching] = useState(false)
+
+  useEffect(() => {
+    const needle = query.trim()
+    if (!needle) {
+      setHits([])
+      setSearching(false)
+      return
+    }
+    setSearching(true)
+    let cancelled = false
+    const timer = setTimeout(() => {
+      void searchSessions(needle)
+        .then((next) => {
+          if (!cancelled) {
+            setHits(next)
+            setSearching(false)
+          }
+        })
+        .catch(() => {
+          if (!cancelled) {
+            setHits([])
+            setSearching(false)
+          }
+        })
+    }, SEARCH_DELAY)
+    return () => {
+      cancelled = true
+      clearTimeout(timer)
+    }
+  }, [query])
+
+  const openSession = (id: string) => {
+    selectSession(id)
+    closeSessionSearch()
+    closeMobileSider()
+  }
+
+  return (
+    <Modal title={t('searchSessions')} closable onClose={closeSessionSearch} mainClassName={styles.main}>
+      <input
+        className={styles.input}
+        autoFocus
+        value={query}
+        placeholder={t('searchPlaceholder')}
+        onChange={(event) => setQuery(event.target.value)}
+        aria-label={t('searchPlaceholder')}
+      />
+      <div className={styles.meta} role="status" aria-live="polite">
+        {searching
+          ? t('searchSearching')
+          : query.trim()
+            ? t('searchResultCount', { count: hits.length })
+            : ''}
+      </div>
+      <div className={styles.list}>
+        {hits.map(({ session, snippet }) => (
+          <button
+            key={session.id}
+            type="button"
+            className={styles.item}
+            onClick={() => openSession(session.id)}
+          >
+            <span className={styles.title}>{session.title || t('untitledChat')}</span>
+            {snippet ? <span className={styles.snippet}>{snippet}</span> : null}
+          </button>
+        ))}
+        {!searching && query.trim() && hits.length === 0 ? (
+          <div className={styles.empty}>{t('searchNoResult')}</div>
+        ) : null}
+      </div>
+    </Modal>
+  )
+}
+
+/** 挂在应用根部：侧边栏收起/展开不影响已打开的搜索弹窗 */
+export const SessionSearch = () => {
+  const open = useSessionSearch((state) => state.open)
+  return open ? <SessionSearchDialog /> : null
+}
