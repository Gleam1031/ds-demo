@@ -0,0 +1,116 @@
+import clsx from 'clsx'
+import { useEffect, useState } from 'react'
+import { useChatStore } from '../../services/chat/store.js'
+import { isVideoMeta, useWallpaperUrls, useWallpapers } from '../../services/wallpapers.js'
+import styles from './WallpaperLayers.module.css'
+
+/** 启动背景显示时长（淡出后卸载） */
+const LAUNCH_DURATION = 1400
+
+const opacityStyle = (opacity: number) => ({ opacity: opacity / 100 })
+
+const WallpaperMedia = ({
+  url,
+  video,
+  className,
+  style,
+}: {
+  url: string
+  video: boolean
+  className?: string
+  style?: React.CSSProperties
+}) =>
+  video ? (
+    <video
+      className={className}
+      style={style}
+      src={url}
+      muted
+      loop
+      autoPlay
+      playsInline
+      disablePictureInPicture
+      aria-hidden="true"
+    />
+  ) : (
+    <img className={className} style={style} src={url} alt="" aria-hidden="true" />
+  )
+
+/**
+ * 背景层：固定在内容之下、页面背景之上。
+ * - 会话页：只显示「会话背景」；
+ * - 主页（无会话）：「会话背景」在下、「主页背景」在上；
+ * - 启动背景：最上层覆盖，短暂停留后淡出。
+ * 每张背景各自有「背景强度」（0 接近原生、100 最清楚）；视频一律 muted（不播音轨）并循环。
+ */
+export const WallpaperLayers = () => {
+  const master = useWallpapers((state) => state.master)
+  const items = useWallpapers((state) => state.items)
+  const urls = useWallpaperUrls()
+  const activeId = useChatStore((state) => state.activeId)
+  const [launched, setLaunched] = useState(false)
+
+  const chatOn = master && items.chat.on && !!urls.chat && items.chat.opacity > 0
+  const homeOn = master && items.home.on && !!urls.home && items.home.opacity > 0
+  const launchOn = master && items.launch.on && !!urls.launch && items.launch.opacity > 0
+  const onChatPage = activeId !== null
+  // 会话页只看会话背景；主页是「会话背景 + 主页背景」
+  const showChat = chatOn
+  const showHome = !onChatPage && homeOn
+  const anyVisible = (onChatPage ? chatOn : chatOn || homeOn) || launchOn
+
+  // 让页面/框架背景透明，背景才透得出来
+  useEffect(() => {
+    const root = document.documentElement
+    if (anyVisible) {
+      root.dataset.wallpaper = 'on'
+    } else {
+      delete root.dataset.wallpaper
+    }
+    return () => {
+      delete root.dataset.wallpaper
+    }
+  }, [anyVisible])
+
+  useEffect(() => {
+    if (!launchOn) {
+      setLaunched(true)
+      return
+    }
+    setLaunched(false)
+    const timer = setTimeout(() => setLaunched(true), LAUNCH_DURATION)
+    return () => clearTimeout(timer)
+  }, [launchOn])
+
+  return (
+    <>
+      {showChat ? (
+        <WallpaperMedia
+          className={styles.layer}
+          style={opacityStyle(items.chat.opacity)}
+          url={urls.chat as string}
+          video={isVideoMeta(items.chat.meta)}
+        />
+      ) : null}
+      {showHome ? (
+        <WallpaperMedia
+          className={clsx(styles.layer, styles.overlay)}
+          style={opacityStyle(items.home.opacity)}
+          url={urls.home as string}
+          video={false}
+        />
+      ) : null}
+
+      {launchOn && !launched ? (
+        <div className={styles.launch} aria-hidden="true">
+          <WallpaperMedia
+            className={styles.launchMedia}
+            style={opacityStyle(items.launch.opacity)}
+            url={urls.launch as string}
+            video={isVideoMeta(items.launch.meta)}
+          />
+        </div>
+      ) : null}
+    </>
+  )
+}
