+/**
+ * 服务端限制：一次请求最多 20 个 document 块（同一 file_id 被重复引用也各计一次）。
+ * 历史提问的附件每次请求都会重发，所以必须按整个请求算，不能只看本轮。
+ */
+const MAX_DOCUMENT_BLOCKS = 20
+/** 超出上限的 document 块换成这句说明，让模型知道有附件被省略 */
+const DOCUMENT_OMITTED_TEXT = '[附件已省略：单次请求最多引用 20 个文档]'
+
+/**
+ * 只保留最新的 MAX_DOCUMENT_BLOCKS 个 document 块，更早的替换为文字说明。
+ * messages 末尾是本轮提问，因此优先保留本轮附件。返回被省略的块数，供界面提示。
+ */
+const pruneDocumentBlocks = (messages: MessageParam[]): { messages: MessageParam[]; omitted: number } => {
+  let budget = MAX_DOCUMENT_BLOCKS
+  let omitted = 0
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const message = messages[i]
+    if (message.role !== 'user' || typeof message.content === 'string') {
+      continue
+    }
+    const blocks = message.content
+    for (let j = blocks.length - 1; j >= 0; j--) {
+      const block = blocks[j]
+      if (block.type !== 'document') {
+        continue
+      }
+      if (budget > 0) {
+        budget -= 1
+        continue
+      }
+      blocks[j] = { type: 'text', text: DOCUMENT_OMITTED_TEXT }
+      omitted += 1
+    }
+  }
+  return { messages, omitted }
+}
+
