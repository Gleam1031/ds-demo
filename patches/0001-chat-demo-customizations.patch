@@ -0,0 +1,52 @@
+/* 壁纸层：固定在内容后面，不接收点击。
+   z-index 用负值，保证只压在其他壁纸之上、内容之下 */
+.layer {
+  position: fixed;
+  inset: 0;
+  z-index: -2;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center;
+  pointer-events: none;
+  user-select: none;
+}
+
+/* 透明 PNG 作为装饰层时要保留完整图形，不裁切 */
+.contain {
+  object-fit: contain;
+}
+
+/* 主页壁纸（透明 PNG）叠在聊天壁纸之上、正文之下 */
+.overlay {
+  z-index: -1;
+}
+
+/* 启动壁纸：盖住一切，短暂显示后淡出 */
+.launch {
+  position: fixed;
+  inset: 0;
+  z-index: 3000;
+  overflow: hidden;
+  pointer-events: none;
+  background: var(--dsw-alias-bg-base);
+  animation: wallpaperLaunchFade 1.4s ease forwards;
+}
+
+.launchMedia {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center;
+}
+
+@keyframes wallpaperLaunchFade {
+  0%,
+  72% {
+    opacity: 1;
+  }
+
+  100% {
+    opacity: 0;
+  }
+}
